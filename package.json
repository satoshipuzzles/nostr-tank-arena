{
  "name": "nostr-tank-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test:live": "node test/two-player.mjs",
    "test:sound": "node test/sound.mjs",
    "shot": "node test/shot.mjs",
    "test:couch": "node test/couch.mjs",
    "test:controls": "node test/controls.mjs",
    "test:cockpit": "node test/cockpit.mjs",
    "test:relays": "node test/relays.mjs",
    "test:mobile": "node test/mobile.mjs",
    "test:board": "node test/board.mjs",
    "test:lobby": "node test/lobby.mjs",
    "test:pads": "node test/pads.mjs"
  },
  "dependencies": {
    "nostr-tools": "^2.10.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "puppeteer-core": "^25.8.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "description": "Four-player tank deathmatch with no game server. Identity, netcode and scores ride on Nostr relays.",
  "license": "MIT"
}
